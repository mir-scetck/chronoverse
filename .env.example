# GEMINI_API_KEY: Required for server-side Gemini AI character dialogue.
# Configured automatically in AI Studio Secrets or in local .env (never commit .env).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL of the hosted application.
APP_URL="MY_APP_URL"

# Optional AI configuration (defaults to gemini-4-hydrogen when GEMINI_API_KEY is set, else scripted offline mode)
AI_MODEL="gemini-4-hydrogen"
PORT="3000"
RATE_LIMIT_PER_MINUTE="30"
